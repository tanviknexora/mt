import sys

import pandas as pd

sys.path.insert(0, r"C:/Users/Administrator/Videos/Office")
from ledger_loader import get_final_ledger

pd.set_option('display.max_columns', None)
MONTHS = ['2026-10', '2026-11']                       # every month to report on: add more here
up = lambda s: s.astype(str).str.strip().str.upper()
KEY = ['ClientID', 'CreatedAt', 'LedgerType', 'Debit', 'Credit']

# ---- Leads file: all months, cleaned ---------------------------------------------------------
df = pd.read_excel(r"C:\Users\Administrator\Downloads\leads_analysis_2026-11-11T10_55_44.739800851Z.xlsx")
df = df[df['tag'] != 'Old Portal_1YT'].rename(columns={'date_of_lead': 'lead_date'})
df['lead_source_1'] = df['lead_source_1'].replace({'(META-IMR)': 'Meta-IMR', 'Meta 1yt IMR': 'Meta-IMR'})
df['zynixx_client_id'] = up(df['zynixx_client_id']).where(df['zynixx_client_id'].notna())
df['lead_date'] = pd.to_datetime(df['lead_date'], format='ISO8601')
df['converted_at'] = pd.to_datetime(df['converted_at'], format='ISO8601')

# ---- One lead per client: the lead that converted, else the earliest ----------------------------
clients = (df.dropna(subset=['zynixx_client_id'])
             .sort_values(['converted_at', 'lead_date'], na_position='last')
             .drop_duplicates('zynixx_client_id')
             [['zynixx_client_id', 'lead_source_1', 'lead_date', 'converted_at']]
             .set_index('zynixx_client_id'))

# ---- Ledger for these clients (loaded once, used for every month) ---------------------------------
led = get_final_ledger(as_pandas=True, columns=tuple(KEY + ['SLNo.']))
led['ClientID'], led['LedgerType'] = up(led['ClientID']), up(led['LedgerType'])
led = led.drop_duplicates(subset=KEY + ['SLNo.'])
cl = led[led['ClientID'].isin(clients.index)]
dep = cl[cl['LedgerType'].eq('DEPOSIT')]
bill = cl[cl['LedgerType'].eq('BILL')]

# ---- Facts about each client that don't depend on the month ----------------------------------------
first_dep = dep.sort_values('CreatedAt').drop_duplicates('ClientID').set_index('ClientID')
clients['ftd_date'] = first_dep['CreatedAt']
clients['ftd_amt'] = first_dep['Credit']
clients['traded'] = clients.index.isin(bill['ClientID'])
clients['alltime_deposit'] = dep.groupby('ClientID')['Credit'].sum()
clients['alltime_deposit'] = clients['alltime_deposit'].fillna(0)


def lead_summary(month):
    """The lead-source report for one month, e.g. '2026-11'."""
    start = pd.Timestamp(month)
    end = start + pd.offsets.MonthBegin(1)
    in_month = lambda s: (s >= start) & (s < end)

    c = clients.copy()
    c['month_deposit'] = dep[in_month(dep['CreatedAt'])].groupby('ClientID')['Credit'].sum()
    c['trade_volume'] = bill[in_month(bill['CreatedAt'])].groupby('ClientID')['Credit'].sum()
    c[['month_deposit', 'trade_volume']] = c[['month_deposit', 'trade_volume']].fillna(0)

    # View 1: new leads, by lead date
    new = df[in_month(df['lead_date'])]
    new_leads = new.groupby('lead_source_1').agg(
        total_leads=('lead_source_1', 'size'),
        full_signups=('zynixx_client_id', 'count'),
        half_signups=('zynixx_client_id', lambda x: x.isna().sum()))

    # View 2: what happened in the month, by event date (any lead month)
    conv = c[in_month(c['converted_at'])]
    ftd = c[in_month(c['ftd_date'])]
    activity = pd.concat([
        conv.groupby('lead_source_1').size().rename('converted'),
        conv[conv['lead_date'] < start].groupby('lead_source_1').size().rename('converted_from_earlier_leads'),
        df[in_month(df['converted_at'])].groupby('lead_source_1').size().rename('converted_in_month'),
        ftd.groupby('lead_source_1').size().rename('ftd'),
        ftd.groupby('lead_source_1')['ftd_amt'].sum(),
        ftd[ftd['traded']].groupby('lead_source_1').size().rename('ftd_traded'),
        c.groupby('lead_source_1')['trade_volume'].sum(),
        c.groupby('lead_source_1')['month_deposit'].sum(),
        c[c['month_deposit'] > 0].groupby('lead_source_1').size().rename('month_depositors'),
        c.groupby('lead_source_1')['alltime_deposit'].sum(),
    ], axis=1)

    counts = ['total_leads', 'full_signups', 'half_signups', 'converted', 'converted_from_earlier_leads',
              'converted_in_month', 'ftd', 'ftd_traded', 'month_depositors']
    out = (new_leads.join(activity, how='outer').fillna(0)
           .astype({k: int for k in counts})
           .rename_axis('lead_source_1').reset_index()
           .sort_values('total_leads', ascending=False))
    out['ftd_traded_pct'] = (out['ftd_traded'] / out['ftd'] * 100).round(1)
    out['contribution_pct'] = (out['month_deposit'] / out['alltime_deposit'] * 100).round(1)

    print(f"{month}: leads {len(new)} | conversions {int(out['converted_in_month'].sum())} | "
          f"deposits {out['month_deposit'].sum():,.2f} vs ledger {dep.loc[in_month(dep['CreatedAt']), 'Credit'].sum():,.2f}")
    return out


# ---- Run every month ---------------------------------------------------------------------------------
summaries = {m: lead_summary(m) for m in MONTHS}
combined = pd.concat(summaries, names=['month']).reset_index(level=0)
print("Ledger up to:", led['CreatedAt'].max())

summaries['2026-11']          # one month;  `combined` has both, with a month column
